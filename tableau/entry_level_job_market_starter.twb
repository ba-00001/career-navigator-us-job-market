      <aliases enabled='yes' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <metadata-records>
        <metadata-record class='comment'>
          <remote-name>Starter workbook created for ISM 4402 final project.</remote-name>
          <remote-type>note</remote-type>
          <local-name>[Starter Note]</local-name>
          <local-type>string</local-type>
        </metadata-record>
      </metadata-records>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Source Granularity Notes'>
      <table>
        <view>
          <datasources>
            <datasource caption='Entry Level Job Market Sources' name='federated.entry_level_job_market' />
          </datasources>
        </view>
        <panes />
      </table>
    </worksheet>
    <worksheet name='Sector Employment Overview'>
      <table>
        <view />
        <panes />
      </table>
    </worksheet>
    <worksheet name='Growth Versus Wage Map'>
      <table>
        <view />
        <panes />
      </table>
    </worksheet>
    <worksheet name='Occupation Clusters'>
      <table>
        <view />
        <panes />
      </table>
    </worksheet>
    <worksheet name='State Sector Comparison'>
      <table>
        <view />
        <panes />
      </table>
    </worksheet>
  </worksheets>
  <dashboards />
  <windows>
    <window class='worksheet' name='Source Granularity Notes' />
    <window class='worksheet' name='Sector Employment Overview' />
    <window class='worksheet' name='Growth Versus Wage Map' />
    <window class='worksheet' name='Occupation Clusters' />
    <window class='worksheet' name='State Sector Comparison' />
  </windows>
</workbook>
