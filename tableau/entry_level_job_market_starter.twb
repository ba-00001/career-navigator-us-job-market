<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='20261.26.0331.1800' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
  </preferences>
  <datasources>
    <datasource caption='Entry Level Job Market Sources' inline='true' name='federated.entry_level_job_market' version='18.1'>
